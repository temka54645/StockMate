# === Мэдээллийн сан ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warehouse

# === Auth.js v5 ===
# openssl rand -hex 32
AUTH_SECRET=
AUTH_URL=https://<app>.up.railway.app
AUTH_TRUST_HOST=true

# === Имэйл (Resend) ===
RESEND_API_KEY=
EMAIL_FROM="Агуулах <noreply@your-domain.com>"

# === Cron хамгаалалт ===
# openssl rand -hex 32
CRON_SECRET=

# === Web Push (VAPID) ===
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# === Anthropic (сонголтоор) ===
ANTHROPIC_API_KEY=

NODE_ENV=production
